set -eu
if [ "$1" = configure ]; then
    if [ -d /run/udev ]; then
        udevadm control --reload-rules
        modprobe uinput
        udevadm trigger --action=add --subsystem-match=misc --sysname-match=uinput
    fi
    echo "Deck installed. See /usr/share/doc/mmesp32-deckd/README.md for group permissions and per-user setup."
fi
