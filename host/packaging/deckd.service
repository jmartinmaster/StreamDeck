[Unit]
Description=MMEsp32 shortcut deck daemon
Documentation=file:///usr/share/doc/mmesp32-deckd/README.md
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/deckd
EnvironmentFile=-%E/mmesp32-deckd/environment
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
